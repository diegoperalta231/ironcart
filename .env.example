# =====================================================================
# IRONCART · Variables de entorno (copiar a .env para desarrollo local con
# `netlify dev`, y configurarlas en Netlify → Site configuration →
# Environment variables para producción). NUNCA subas el archivo .env.
# =====================================================================

# --- Supabase (PostgreSQL) — OBLIGATORIAS -----------------------------
# Project Settings → API (o "API Keys"). Usa la clave secreta / service_role:
# solo vive en el servidor (Netlify Functions), nunca en el navegador.
SUPABASE_URL=https://TU-PROYECTO.supabase.co
SUPABASE_SERVICE_ROLE_KEY=

# --- Anthropic (Claude) — OBLIGATORIA para respuestas con IA -----------
# https://console.anthropic.com/ → API Keys. Sin ella, Spot funciona en
# "modo limitado" (respuestas deterministas con datos reales, sin IA).
ANTHROPIC_API_KEY=
# Modelo configurable (ver https://docs.claude.com/en/docs/about-claude/models)
ANTHROPIC_MODEL=claude-haiku-5-5
ANTHROPIC_MAX_TOKENS=700
# Netlify corta las funciones síncronas a los ~10 s (plan gratuito): dejamos margen.
ANTHROPIC_TIMEOUT_MS=8500

# --- Embeddings para RAG vectorial (OPCIONAL) ---------------------------
# Anthropic no ofrece embeddings. Con Voyage AI + 003_pgvector.sql se activa la
# búsqueda híbrida (pgvector + texto). Sin clave se usa búsqueda de texto completo.
VOYAGE_API_KEY=
VOYAGE_MODEL=voyage-3.5
# Token para POST /api/admin/embeddings (genera los vectores). Mínimo 16 caracteres.
ADMIN_TOKEN=

# --- Seguridad y límites -----------------------------------------------
# Sal para anonimizar IPs en el rate limiting (cualquier texto largo y aleatorio).
IP_HASH_SALT=
# Orígenes extra permitidos por CORS (separados por comas). Normalmente vacío.
ALLOWED_ORIGINS=
CHAT_RATE_PER_MINUTE=10
CHAT_RATE_PER_DAY=150
# Turnos de historial (usuario + asistente) que recibe Claude: 4 a 6 recomendado.
SPOT_HISTORY_TURNS=5

# --- Frontend (OPCIONAL, es pública: no pongas secretos con prefijo VITE_) ---
# URL de una fotografía con licencia para el fondo del hero.
VITE_HERO_IMAGE_URL=
